# Verbose API stdout logging (OID4VCI process-offer step summary, no tokens in body).
# CREDENTIAL_DOJO_DEBUG=1

# When debug is on, issuer error bodies in steps and debug logs are clipped at ~512k chars
# (vs ~8k when off) so validation errors are not truncated in Railway logs.

# Or: DEBUG=credential-dojo (can combine: DEBUG=credential-dojo,other-lib)

PORT=3001
