# Optional. Leave unset to use same-origin /api (Vite dev proxy or combined deploy).
# VITE_API_BASE=https://api.credential.ninja

# Verbose browser console logging (Kinchaku OID4VCI, QR modal). Reload after changing.
# VITE_DEBUG=true

# Or without rebuild: in DevTools console run:
#   localStorage.setItem('credential-dojo-debug', '1')
# Disable: localStorage.removeItem('credential-dojo-debug')

# Railway / vite preview: proxy /api to your API service when not using Docker/nginx.
# API_PROXY_TARGET=https://your-api.up.railway.app
