{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:app-icon && vite",
    "generate:og": "node ./scripts/generate-og-png.mjs",
    "generate:app-icon": "node ./scripts/generate-app-icon-png.mjs",
    "build": "npm run generate:og && npm run generate:app-icon && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "sh -c \"exec serve dist -s -p ${PORT:-3000}\""
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "augmented-ui": "^2.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "reactflow": "^11.11.4",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0"
  }
}
